# --- LLM + Embeddings (Google Gemini -- free tier, get a key at aistudio.google.com/apikey) ---
GOOGLE_API_KEY=dummy-replace-me

# --- Pinecone ---
PINECONE_API_KEY=pcsk-dummy-replace-me
PINECONE_INDEX_NAME=legixo-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- App config ---
CORPUS_DIR=corpus
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_LOOPS=2

# --- Models ---
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768
